# Copy to .env before starting the server.
# The caller's VENDOR_API_KEY must hold the same value.
API_KEY=local-dev-key

# Optional. Defaults to 4000.
# PORT=4000

# Optional. A number from 0 to 1: the chance a quote request fails on
# purpose, simulating the vendor. Defaults to 0 — off.
FAILURE_RATE=0
